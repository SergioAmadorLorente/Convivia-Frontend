{
  "expo": {
    "name": "Convivia",
    "slug": "Convivia",
    "version": "3.8.39",
    "orientation": "portrait",
    "icon": "./src/assets/logoReal.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/ConviviaLogoAndroid.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kiwi22.Convivia"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "bc3d062b-923e-4b28-997e-85c890dffecd"
      }
    }
  }
}